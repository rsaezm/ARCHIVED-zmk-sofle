#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        azul: blanco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mo 1 &rgb_ug RGB_COLOR_HSB(226,100,69)>;
            label = "BLANCO";
        };

        verde: verde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mo 2 &rgb_ug RGB_COLOR_HSB(114,100,50)>;
            label = "VERDE";
        };

        rojo: rojo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mo 3 &rgb_ug RGB_COLOR_HSB(0,95,50)>;
            label = "ROJO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Texto {
            bindings = <
&kp GRAVE   &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7  &kp N8     &kp N9     &kp N0     &kp NON_US_BACKSLASH
&kp ESC     &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U   &kp I      &kp O      &kp P      &kp BACKSPACE
&kp TAB     &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J   &kp K      &kp L      &kp SQT    &kp SEMICOLON
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M   &kp COMMA  &kp DOT    &kp FSLH   &kp RIGHT_SHIFT
&kp C_MUTE  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &azul   &kp SPACE    &kp ENTER        &kp ENTER  &verde  &none      &kp MINUS  &kp EQUAL
            >;

            sensor-bindings = <&none>, <&none>;

            display-name = "Windows";
            label = "Texto";
        };

        Simbolos {
            bindings = <
&none  &none  &none  &none  &none  &none    &mmv MOVE_UP     &none          &kp SLASH  &kp ASTERISK  &kp MINUS         &kp PLUS           &none
&none  &none  &none  &none  &none  &none    &mmv MOVE_DOWN   &none          &none      &none         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&none  &none  &none  &none  &none  &none    &mmv MOVE_LEFT   &none          &none      &none         &kp LEFT_BRACE    &kp RIGHT_BRACE    &none
&none  &none  &none  &none  &none  &none    &mmv MOVE_RIGHT  &kp RA(TILDE)  &none      &none         &none             &none              &none
&none  &none  &none  &none  &none  &none    &mkp LCLK        &none          &rojo      &none         &none             &none
            >;

            display-name = "Funciones";
            sensor-bindings = <&none>, <&none>;

            label = "Simbolos";
        };

        Funcion {
            bindings = <
&none       &kp F1  &kp F2   &kp F3   &kp F4   &none     &mmv MOVE_UP     &none      &none     &none     &none      &none  &none
&trans      &kp F5  &kp F6   &kp F7   &kp F8   &none     &mmv MOVE_DOWN   &kp PG_UP  &kp HOME  &kp UP    &kp END    &none  &kp DEL
&trans      &kp F9  &kp F10  &kp F11  &kp F12  &none     &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&trans      &none   &none    &none    &none    &none     &mmv MOVE_RIGHT  &none      &none     &none     &none      &none  &trans
&kp C_MUTE  &trans  &trans   &trans   &rojo    &trans    &mkp LCLK        &none      &none     &none     &none      &none
            >;

            sensor-bindings = <&none>, <&none>;

            display-name = "Simbolos";
            label = "Funcion";
        };

        Sistema {
            bindings = <
&none      &none  &none  &none  &bt BT_CLR  &bt BT_CLR_ALL    &none  &rgb_ug RGB_OFF  &rgb_ug RGB_ON   &none            &none            &none  &none
&soft_off  &none  &none  &none  &bt BT_PRV  &bt BT_NXT        &none  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &none            &none            &none  &sys_reset
&none      &none  &none  &none  &none       &out OUT_TOG      &none  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &none  &none
&none      &none  &none  &none  &none       &none             &none  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &none  &none
&none      &none  &none  &none  &none       &none             &none  &none            &none            &none            &none            &none
            >;

            label = "Sistema";
        };
    };
};
